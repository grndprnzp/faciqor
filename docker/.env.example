# PostgreSQL Environment Configuration Template
# Kopiere diese Datei nach .env: cp docker/.env.example docker/.env

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=faciqor_dev
POSTGRES_PORT=5432
 
# SeaweedFS (S3-kompatibler Object Storage)
STORAGE_S3_PORT=8333
STORAGE_FILER_PORT=8888
STORAGE_MASTER_PORT=9333
